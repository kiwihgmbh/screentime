# Copy to .env and fill in. Never commit .env.
#
# Generate the two secrets below with:
#   openssl rand -base64 48

# database
POSTGRES_DB=screentime
POSTGRES_USER=screentime
POSTGRES_PASSWORD=change-me

# Only needed when running the backend outside docker compose, for example
# with ./mvnw spring-boot:run against a local postgres. Compose sets this
# itself from POSTGRES_DB.
DB_URL=jdbc:postgresql://localhost:5432/screentime

# security
# at least 32 characters, and not a phrase anyone could guess: the app refuses
# to start with anything shorter
JWT_SECRET=change-me-to-a-long-random-string
# 30 days, so a child is not logged out every day and stops booking
JWT_TTL_DAYS=30

# The first parent account, created on first startup only. The application
# refuses to start if either of these is missing. Change the password in the
# app afterwards; this value is not read again once the account exists.
APP_ADMIN_USER=parent
APP_ADMIN_PASSWORD=change-me

# application
# every calendar decision is made in this zone; instants are stored in UTC
APP_TIMEZONE=Europe/Zurich
APP_PUBLIC_URL=https://screentime.example.com

# Where compose publishes the app. The default binds to localhost only: put a
# reverse proxy with TLS in front rather than exposing this to the network.
# Set APP_BIND_ADDRESS=0.0.0.0 only if you know what is in front of it.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
