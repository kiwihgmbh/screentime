# Copy to .env and fill in. Never commit .env.

# database
POSTGRES_DB=screentime
POSTGRES_USER=screentime
POSTGRES_PASSWORD=change-me
DB_URL=jdbc:postgresql://screentime-db:5432/screentime

# security
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_DAYS=30

# first parent account, created on first startup only
APP_ADMIN_USER=parent
APP_ADMIN_PASSWORD=change-me

# application
APP_TIMEZONE=Europe/Zurich
APP_PUBLIC_URL=https://screentime.example.com
